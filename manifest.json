{
  "manifest_version": 3,
  "name": "CopyType — Delayed Code Entry",
  "short_name": "CopyType",
  "version": "1.2.0",
  "description": "Accurate code entry and a compact same-profile browser workspace.",
  "minimum_chrome_version": "118",
  "permissions": ["activeTab", "scripting", "storage", "debugger"],
  "action": { "default_title": "CopyType", "default_popup": "popup.html" },
  "background": { "service_worker": "background.js" }
}
