{
  "name": "copytype-editor",
  "displayName": "CopyType Editor Connection",
  "description": "Send exact, paced text from the local CopyType desktop app to an explicitly selected editor.",
  "publisher": "copytype-local",
  "version": "0.1.0",
  "engines": {"vscode": "^1.85.0"},
  "main": "./extension.cjs",
  "activationEvents": ["onStartupFinished"],
  "extensionKind": ["ui"],
  "categories": ["Other"],
  "contributes": {
    "commands": [
      {"command": "copytype.selectEditor", "title": "CopyType: Use This Editor"},
      {"command": "copytype.disconnect", "title": "CopyType: Disconnect Editor"}
    ]
  }
}
