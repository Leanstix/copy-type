{
  "name": "copytype-editor",
  "displayName": "CopyType Editor Connection",
  "description": "Discover open VS Code tabs and create workspace files from the local CopyType desktop app.",
  "publisher": "copytype-local",
  "version": "0.2.0",
  "engines": {"vscode": "^1.85.0"},
  "main": "./extension.cjs",
  "activationEvents": ["onStartupFinished"],
  "extensionKind": ["ui"],
  "categories": ["Other"],
  "contributes": {
    "commands": [
      {"command": "copytype.selectEditor", "title": "CopyType: Reconnect to Desktop"},
      {"command": "copytype.disconnect", "title": "CopyType: Disconnect Editor"}
    ]
  }
}
